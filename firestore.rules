rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Menu items shown to customers on the ordering page and managed from the staff page.
    // No login system exists yet, so writes are open to anyone with the site link.
    match /menu/{itemId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'price', 'category', 'available'])
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.category is string
        && request.resource.data.available is bool;
      allow delete: if true;
    }

    // Customer orders. Anyone can place an order (no login for customers).
    // Updates are limited to status/updatedAt so a customer can't rewrite items/total after the fact.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'preparing', 'ready', 'done', 'cancelled'];
      allow delete: if false;
    }

    // Daily counters used only to hand out short, friendly order numbers (e.g. "#7").
    match /counters/{counterId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count is number;
    }

    // Rolled-up takings: one small document per day (id "YYYY-MM-DD") and one running all-time
    // total in summary/sales. The daily report reads these rather than every order ever placed,
    // which is what keeps it correct and cheap as the months add up.
    match /dailySales/{day} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['date', 'orderCount', 'cancelledCount', 'revenue', 'items'])
        && request.resource.data.date is string
        && request.resource.data.orderCount is number
        && request.resource.data.revenue is number;
      allow delete: if false;
    }

    match /summary/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['orderCount', 'revenue'])
        && request.resource.data.orderCount is number
        && request.resource.data.revenue is number;
      allow delete: if false;
    }

    // Membership records keyed by phone number (the document id). Written both by the customer
    // ordering page (auto drink-count tracking) and the staff POS (manual stamps/registration,
    // and edit/delete from the back-office member list). No login system exists yet, so writes
    // are open to anyone with the site link (same trust model as menu).
    match /customers/{phone} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(
          ['phone', 'name', 'points', 'totalEarned', 'totalDrinks', 'orderCount', 'lastVisit'])
        && request.resource.data.phone is string
        && request.resource.data.name is string
        && request.resource.data.points is number
        && request.resource.data.totalEarned is number
        && request.resource.data.totalDrinks is number
        && request.resource.data.orderCount is number;
      allow delete: if true;
    }

    // Append-only log of manual stamp/redeem actions from the staff POS.
    match /loyaltyEvents/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['phone', 'type', 'amount'])
        && request.resource.data.type in ['ADD', 'REDEEM']
        && request.resource.data.amount is number;
      allow update, delete: if false;
    }

    // Manual daily income/expense entries for the back-office cashbook report (e.g. cash
    // sales outside the ordering flow, ingredient purchases, rent). No edit-in-place — a
    // mistaken entry is deleted and re-added. Same open trust model as the rest of the app.
    match /cashbook/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['type', 'amount', 'note', 'date'])
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.note is string
        && request.resource.data.date is string;
      allow update: if false;
      allow delete: if true;
    }
  }
}
